# This computer's own: where the game is, where the map data goes
/config.json
# The map data, where it is kept beside the map tool (built from your own installed game)
/data/
# Built or fetched on this computer when first needed
/server/.build/
/extractor/dbd/
# Which version a copy without git was last updated to (server/appupdate.js)
/.app-version.json
node_modules/
*.log
# The application as built to hand on (npm run dist), and a shortcut to it of your own
/dist/
*.lnk
# A separate tool of its own (its own git repository), for checking the database against Wowhead
/wowhead-scraper/
# The scheduled function (functions/): its libraries, the copy of the files it shares with the map
# (functions/prepare.mjs makes it), and what the Firebase tools keep for themselves
/functions/node_modules/
/functions/shared/
/.firebase/
