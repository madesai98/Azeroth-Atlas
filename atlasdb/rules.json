{
  "rules": {
    ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
    ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
    "meta": {
      ".read": "auth != null"
    },
    "truth": {
      ".read": "auth != null"
    },
    "inbox": {
      "$copy": {
        "$delivery": {
          ".write": "auth != null && auth.uid === $copy && !data.exists()",
          ".validate": "newData.hasChildren(['v', 'at'])",
          "v": { ".validate": "newData.val() === 1" },
          "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "app": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "build": { ".validate": "newData.isNumber()" },
          "npc": { "$id": { ".validate": "$id.matches(/^i[0-9]{1,9}$/)" } },
          "object": { "$id": { ".validate": "$id.matches(/^i[0-9]{1,9}$/)" } },
          "quest": { "$id": { ".validate": "$id.matches(/^i[0-9]{1,9}$/)" } },
          "seen": { "$n": { ".validate": "newData.isString() && newData.val().length <= 100" } },
          "$other": { ".validate": false }
        }
      }
    },
    "installs": {
      "$copy": {
        ".write": "auth != null && auth.uid === $copy",
        ".validate": "newData.hasChild('last')",
        "last": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "app": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "build": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
